# Minerva's Scribe v3: copy to `.env` and fill in. NEVER commit `.env`.
# The root .gitignore lists `.env` (and `.env.*`), so the filled-in file is never committed.

# Full `cookie` request header from any forum.minerva.edu/api request (DevTools -> Network).
# It is a login credential: keep it local. It expires; refresh it when `scribe me` fails.
FORUM_COOKIE=

# Default ASR provider (Nova-3, diarization, keyterms). EU endpoint is the default.
DEEPGRAM_API_KEY=
# DEEPGRAM_API_URL=https://api.eu.deepgram.com/v1/listen

# Fallback provider (Whisper via Groq; no diarization).
GROQ_API_KEY=

# Optional: stable secret for `--privacy ids` pseudonyms (otherwise scribe_data/.id_salt).
# SCRIBE_ID_SALT=

# Optional local-server hardening: pin CORS to your extension's id.
# SCRIBE_ALLOWED_ORIGINS=chrome-extension://<your-extension-id>
